<!-- ==========================================================================
     ГЛАВНОЕ ОКНО ПРИЛОЖЕНИЯ (MainWindow)
     x:Class — связывает этот XAML-файл с C#-классом MainWindow
     xmlns — пространства имен (стандартные для WPF)
     Title — заголовок окна в панели задач
     Height/Width — начальный размер окна в пикселях
     WindowStartupLocation="CenterScreen" — окно откроется по центру экрана
     Background — цвет фона всего окна (светло-серо-голубой)
========================================================================== -->
<Window x:Class="homeWork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Menu" Height="500" Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <!-- ГЛАВНАЯ СЕТКА (Grid) — контейнер, который делит окно на строки и столбцы -->
    <Grid>
        <!-- Определяем СТОЛБЦЫ главной сетки. Width="*" — займи всё доступное место -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Определяем СТРОКИ главной сетки:
             Auto — высота по содержимому (шапка и подвал)
             *    — растягивается на всё оставшееся место (основная часть) -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Строка 0: Верхняя шапка -->
            <RowDefinition Height="*"/>
            <!-- Строка 1: Основная часть (меню + таблица) -->
            <RowDefinition Height="Auto"/>
            <!-- Строка 2: Нижняя панель с Exit -->
        </Grid.RowDefinitions>

        <!-- ======================================================================
             1. ВЕРХНЯЯ ШАПКА
             Border — рамка с фоном. Grid.Row="0" — лежит в первой строке.
             Background="#1E3A8A" — глубокий синий цвет (создает контраст).
             Padding — внутренние отступы (15 по бокам, 10 сверху/снизу).
             Grid.ColumnSpan="2" — растягивается на 2 столбца (на всю ширину).
        ======================================================================= -->
        <Border Grid.Row="0" Background="#1E3A8A" Padding="15,10">
            <TextBlock Text="Икея пре-альфа"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#FBBF24"
                       HorizontalAlignment="Center"/>
            <!-- FontSize — размер шрифта
                 FontWeight="Bold" — жирный текст
                 Foreground — цвет текста (золотисто-жёлтый, хорошо читается на синем)
                 HorizontalAlignment="Center" — центрируем текст по горизонтали -->
        </Border>

        <!-- ======================================================================
             2. ОСНОВНАЯ ЧАСТЬ (Grid.Row="1" — вторая строка)
             Вложенный Grid, который делит область на 2 столбца:
             слева — меню (220px), справа — таблица (растягивается)
        ======================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <!-- Фиксированная ширина меню -->
                <ColumnDefinition Width="*"/>
                <!-- Таблица занимает остаток -->
            </Grid.ColumnDefinitions>

            <!-- 2.1. ЛЕВОЕ БОКОВОЕ МЕНЮ
                 Background="#E8EEF5" — нежный голубовато-серый фон
                 Padding="10" — отступы внутри меню -->
            <Border Grid.Column="0" Background="#E8EEF5" Padding="10">
                <StackPanel>
                    <!-- StackPanel — контейнер, который ставит элементы друг за другом по вертикали -->

                    <TextBlock Text="Навигация"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#1E3A8A"
                               Margin="0,0,0,12"/>
                    <!-- Margin — внешние отступы: 0 слева, 0 сверху, 0 справа, 12 снизу -->

                    <!-- Кнопка "Товары" — изумрудный акцент (главная кнопка) -->
                    <Button Content=" Товары"
                            Height="42" Margin="0,0,0,8" FontSize="14"
                            Background="#10B981" Foreground="White"
                            BorderThickness="0" FontWeight="SemiBold"/>

                    <!-- Кнопка "Заказы" — белая с тонкой рамкой -->
                    <Button Content=" Заказы"
                            Height="42" Margin="0,0,0,8" FontSize="14"
                            Background="White" Foreground="#1E293B"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="Button_Click_1"/>

                    <!-- Кнопка "Клиенты" -->
                    <Button Content=" Клиенты"
                            Height="42" Margin="0,0,0,8" FontSize="14"
                            Background="White" Foreground="#1E293B"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="Button_Click"/>

                    <!-- Кнопка "Отчеты" -->
                    <Button Content=" Отчеты"
                            Height="42" Margin="0,0,0,8" FontSize="14"
                            Background="White" Foreground="#1E293B"
                            BorderBrush="#CBD5E1" BorderThickness="1"
                            Click="Button_Click_1"/>

                    <!-- Кнопка "Настройки" — с желтоватым акцентом -->
                    <Button Content=" Настройки"
                            Height="42" Margin="0,0,0,8" FontSize="14"
                            Background="#FEF3C7" Foreground="#92400E"
                            BorderThickness="0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 2.2. ТАБЛИЦА (правая часть)
                 DataGrid — элемент для отображения табличных данных
                 x:Name="MyTable" — имя, по которому мы обращаемся из C#-кода -->
            <Border Grid.Column="1" Margin="15">
                <DataGrid x:Name="MyTable"
                          Background="White"
                          BorderThickness="1"
                          BorderBrush="#CBD5E1"
                          RowBackground="White"                   
                          AlternatingRowBackground="#F0F9FF"     
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          FontSize="13"/>
                <!-- RowBackground — цвет обычных строк
                     AlternatingRowBackground — цвет чётных строк (зебра)
                     HeadersVisibility — показывать только заголовки колонок
                     GridLinesVisibility — показывать только горизонтальные линии -->
            </Border>
        </Grid>

        <!-- ======================================================================
             3. НИЖНЯЯ ПАНЕЛЬ (Grid.Row="2" — третья строка)
        ======================================================================= -->
        <Border Grid.Row="2" Background="#E8EEF5" Padding="10">
            <Button x:Name="ExitBtn"
                    Content="Exit"
                    Width="110" Height="36"
                    HorizontalAlignment="Right"
                    Click="ExitBtn_Click"
                    Background="#EF4444"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="13"
                    BorderThickness="0"/>
            <!-- HorizontalAlignment="Right" — прижимает кнопку к правому краю
                 Background="#EF4444" — красный цвет (стандарт для кнопки выхода)
                 Click="ExitBtn_Click" — при нажатии вызовется метод в C# -->
        </Border>

    </Grid>
</Window>
